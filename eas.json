{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WAYMARK_APP_VARIANT": "dev",
        "EXPO_PUBLIC_WAYMARK_APPLICATION_ID": "com.waymark.lifeos.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WAYMARK_APP_VARIANT": "prod",
        "EXPO_PUBLIC_WAYMARK_PREVIEW_TOOLS": "true",
        "EXPO_PUBLIC_WAYMARK_APPLICATION_ID": "com.waymark.lifeos"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WAYMARK_APP_VARIANT": "prod",
        "EXPO_PUBLIC_WAYMARK_PREVIEW_TOOLS": "true",
        "EXPO_PUBLIC_WAYMARK_APPLICATION_ID": "com.waymark.lifeos"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-tools": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WAYMARK_APP_VARIANT": "prod",
        "EXPO_PUBLIC_WAYMARK_PREVIEW_TOOLS": "true",
        "EXPO_PUBLIC_WAYMARK_APPLICATION_ID": "com.waymark.lifeos"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_WAYMARK_APPLICATION_ID": "com.waymark.lifeos"
      }
    }
  }
}
